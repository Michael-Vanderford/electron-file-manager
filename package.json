{
    "name": "electron-file-manager",
    "version": "2.1.0",
    "description": "Electron File Manager",
    "homepage": "https://github.com/michael-vanderford/sfm",
    "main": "src/main/main.js",
    "scripts": {
        "start": "electron . --ozone-platform=x11 --no-sandbox",
        "build": "npx electron-builder --linux",
        "build:win": "npx electron-builder --win",
        "test": "npm run test:unit",
        "test:unit": "jest --runInBand --testPathIgnorePatterns=autocomplete.test.js",
        "test:e2e": "playwright test"
    },
    "build": {
        "appId": "com.stringboard.sfm",
        "directories": {
            "buildResources": "build"
        },
        "linux": {
            "target": [
                "deb",
                "rpm",
                "AppImage",
                "snap"
            ],
            "icon": "build/icons",
            "executableName": "efm",
            "executableArgs": [
                "--ozone-platform=x11"
            ],
            "category": "Utility",
            "desktop": {
                "entry": {
                    "Name": "Electron File Manager",
                    "Comment": "A modern file manager built with Electron",
                    "Categories": "Utility;FileManager;"
                }
            }
        },
        "win": {
            "target": "nsis",
            "executableName": "efm"
        },
        "snapcraft": {
            "base": "core22",
            "core22": {
                "summary": "A modern file manager built with Electron",
                "confinement": "classic"
            }
        }
    },
    "author": {
        "name": "Michael Vanderford",
        "email": "michael.vanderford@gmail.com"
    },
    "license": "LGPL-2.1-or-later",
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@types/jest": "^30.0.0",
        "bootstrap-icons": "^1.11.3",
        "electron": "^44.4.5",
        "electron-builder": "^26.5.0",
        "jest": "^30.5.2",
        "nan": "^2.29.0",
        "node-abi": "^4.35.0",
        "node-gyp": "^13.0.2"
    },
    "dependencies": {
        "archiver": "^7.0.1",
        "chart.js": "^4.5.1",
        "fast-xml-parser": "^5.4.1",
        "material-design-icons": "^3.0.1"
    },
    "optionalDependencies": {
        "libgio-node": "^1.0.11"
    }
}
